<%- include('partials/head') %>
<h1>Reports</h1>

<h2>Most common codes</h2>
<% if (!topCodes.length) { %><p>No data yet.</p><% } %>
<table>
    <% topCodes.forEach(c => { %>
        <tr><td><strong><%= c._id %></strong></td><td><%= c.count %></td><td><%- include('partials/severity', { level: c.severity }) %></td></tr>
    <% }) %>
</table>

<h2>By car make</h2>
<table>
    <% byMake.forEach(m => { %>
        <tr>
            <td><strong><%= m._id %></strong> (<%= m.total %>)</td>
            <td><%= m.codes.map(c => `${c.code} ×${c.count}`).join(', ') %></td>
        </tr>
    <% }) %>
</table>
<%- include('partials/foot') %>
