<% const on = (prefix) => (path.startsWith(prefix) ? 'active' : ''); %>
<nav>
    <a href="/" class="brand">Auto<span>Code</span></a>
    <div class="nav-links">
        <a href="/obd" class="<%= on('/obd') %>">OBD Codes</a>
        <% if (user) { %>
            <a href="/garage" class="<%= on('/garage') %>">My Garage</a>
            <a href="/agent" class="<%= path === '/agent' || path.startsWith('/agent/ask') ? 'active' : '' %>">Assistant</a>
            <% if (user.canControlAgent) { %><a href="/agent/admin" class="nav-admin <%= on('/agent/admin') %>">Agent Control</a><% } %>
            <% if (['admin', 'superowner'].includes(user.role)) { %><a href="/users" class="nav-admin <%= path === '/users' || path === '/users/new' ? 'active' : '' %>">Users</a><% } %>
        <% } %>
    </div>
    <div class="nav-user">
        <% if (user) { %>
            <a href="/users/<%= user._id %>" class="nav-profile <%= path === `/users/${user._id}` ? 'active' : '' %>"><span class="avatar"><%= user.username.charAt(0).toUpperCase() %></span><%= user.username %></a>
            <a href="/auth/logout" class="nav-logout">Logout</a>
        <% } else { %>
            <a href="/auth/login" class="<%= on('/auth/login') %>">Login</a>
            <a href="/auth/signup" class="button-link">Sign Up</a>
        <% } %>
    </div>
</nav>
