<nav>
    <a href="/">Home</a>
    <a href="/obd">OBD Codes</a>
    <% if (user) { %>
        <a href="/garage">My Garage</a>
        <a href="/agent">Assistant</a>
        <a href="/users/<%= user._id %>">My Profile</a>
        <% if (user.canControlAgent) { %><a href="/agent/admin">Agent Control</a><% } %>
        <% if (['admin', 'superowner'].includes(user.role)) { %><a href="/users">Users</a><% } %>
        <a href="/auth/logout">Logout (<%= user.username %>)</a>
    <% } else { %>
        <a href="/auth/login">Login</a>
        <a href="/auth/signup">Sign Up</a>
    <% } %>
</nav>
