<%- include('../partials/head') %>
<h1>Edit car</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form action="/garage/<%= car._id %>?_method=PUT" method="POST">
    <%- include('../partials/carFields', { car }) %>
    <select name="year" required>
        <% (years.includes(car.year) ? years : [car.year, ...years]).forEach(y => { %>
            <option value="<%= y %>" <%= car.year === y ? 'selected' : '' %>><%= y %></option>
        <% }) %>
    </select>
    <input name="mileage" type="number" min="0" value="<%= car.mileage != null ? car.mileage : '' %>" placeholder="Mileage in km (optional)">
    <input name="vin" value="<%= car.vin || '' %>" placeholder="VIN (optional)">
    <button>Update</button>
    <a href="/garage/<%= car._id %>">Cancel</a>
</form>
<%- include('../partials/foot') %>
