<%- include('../partials/head') %>
<h1>My Log</h1>
<% if (!logs.length) { %><p>Nothing logged yet.</p><% } %>
<table>
    <thead>
        <tr><th>Date Logged</th><th>Vehicle</th><th>DTC</th><th>Severity</th><th>Repair Status</th></tr>
    </thead>
    <% logs.forEach(log => { %>
        <tr class="<%= log.status === 'Resolved' ? 'resolved' : '' %>">
            <td><%= log.createdAt.toLocaleDateString() %></td>
            <td><% if (log.car) { %><a href="/garage/<%= log.car._id %>"><%= log.car.make %> <%= log.car.model %></a><% } %></td>
            <td><strong><%= log.code %></strong></td>
            <td><%- include('../partials/severity', { level: log.severity }) %></td>
            <td><%= log.status %></td>
        </tr>
    <% }) %>
</table>
<%- include('../partials/foot') %>
