<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AutoCode | System</title>
</head>

<body>
    <header>
        <h3>Cars Diagnostic System</h3>
        <%-include('partials/navbar')%>
    </header>
    <main>
        <h2>Diagnostic & Sensore</h2>
        <p>Monitore cars diagnostic cods, sensore, and mechanical status.</p>

        <ul>
            <% system.forEach(sys=> { %>
                <li>
                    <strong>
                        <%=sys.name%>
                    </strong> - Status: <%=sys.status%> (code: <%=sys.code%>)
                </li>
                <% }) %>
        </ul>
    </main>
</body>

</html>