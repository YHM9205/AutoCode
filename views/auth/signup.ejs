<%- include('../partials/head', { title: 'Sign up' }) %>
<h1>Sign Up for Auto-Code</h1>
<% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
<form action="/auth/signup" method="POST">
    <div>
        <label for="username">Username:</label>
        <input type="text" name="username" id="username" value="<%= values.username || '' %>" minlength="2" maxlength="50" required>
    </div>
    <div>
        <label for="email">Email:</label>
        <input type="email" name="email" id="email" value="<%= values.email || '' %>" required>
    </div>
    <div>
        <label for="fullName">Full name (optional):</label>
        <input type="text" name="fullName" id="fullName" value="<%= values.fullName || '' %>">
    </div>
    <div>
        <label for="phone">Phone (optional):</label>
        <input type="tel" name="phone" id="phone" value="<%= values.phone || '' %>">
    </div>
    <div>
        <label for="garageName">Garage name (optional):</label>
        <input type="text" name="garageName" id="garageName" value="<%= values.garageName || '' %>">
    </div>
    <fieldset class="choice">
        <legend>Gender</legend>
        <label><input type="radio" name="gender" value="male" <%= values.gender === 'male' ? 'checked' : '' %> required> Male</label>
        <label><input type="radio" name="gender" value="female" <%= values.gender === 'female' ? 'checked' : '' %>> Female</label>
    </fieldset>
    <div>
        <label for="level">How well do you know cars?</label>
        <select name="level" id="level">
            <option value="beginner" <%= (values.level || 'beginner') === 'beginner' ? 'selected' : '' %>>I don't know much</option>
            <option value="intermediate" <%= values.level === 'intermediate' ? 'selected' : '' %>>I know a bit</option>
            <option value="expert" <%= values.level === 'expert' ? 'selected' : '' %>>Engineer 🔧</option>
        </select>
    </div>
    <div>
        <label for="password">Password (more than 6 characters):</label>
        <input type="password" name="password" id="password" minlength="7" required>
    </div>
    <div>
        <label for="confirmPassword">Confirm Password:</label>
        <input type="password" name="confirmPassword" id="confirmPassword" minlength="7" required>
    </div>
    <button type="submit">Sign Up</button>
</form>
<p>Already have an account? <a href="/auth/login">Login</a></p>
<%- include('../partials/foot') %>
