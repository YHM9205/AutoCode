<%- include('../partials/head') %>
<h1><%= agent.name %></h1>

<% if (agent.status !== 'Active') { %>
    <p class="error">The assistant is not available right now (<%= agent.status %>).</p>
<% } else { %>
    <% if (sent) { %><p>Thanks, your correction was sent for review.</p><% } %>

    <% const thread = [...turns, ...(answer && answer.said ? [{ q: question, a: answer.said.text, f: answer.said.followUp && answer.said.followUp.text, now: true }] : [])]; %>
    <% if (thread.length) { %>
        <div class="chat">
            <% thread.forEach(t => { %>
                <p class="bubble me" dir="auto"><%= t.q %></p>
                <div class="bubble bot<%= t.now ? ' now' : '' %>" dir="auto">
                    <p><%= t.a %></p>
                    <% if (t.f) { %><p class="ask"><%= t.f %></p><% } %>
                </div>
            <% }) %>
        </div>
    <% } %>

    <form action="/agent/ask" method="POST" class="search-form">
        <% if (cars.length) { %>
            <select name="carId">
                <option value="">All my cars</option>
                <% cars.forEach(c => { %>
                    <option value="<%= c._id %>" <%= carId === String(c._id) ? 'selected' : '' %>><%= c.year %> <%= c.make %> <%= c.model %></option>
                <% }) %>
            </select>
        <% } %>
        <% const waiting = answer && answer.said && answer.said.followUp; %>
        <input name="question" dir="auto" maxlength="500" autofocus required
            placeholder="<%= waiting ? 'Answer the question, or describe something else' : 'Describe the problem or type a code: السيارة ترجف وتطفي / P0300' %>">
        <button>Send</button>
    </form>
    <% if (thread.length) { %>
        <form action="/agent/new" method="POST" class="new-chat">
            <button>New conversation</button>
        </form>
    <% } %>

    <% if (answer) { %>
        <% const carName = car ? `${car.make} ${car.model}` : null; %>
        <% const verdicts = {
            stop: 'Stop the car now',
            soon: 'Visit a workshop soon',
            unknown: 'Have it checked at a workshop',
            drive: 'Safe to keep driving'
        }; %>

        <% if (answer.verdict) { %>
            <div class="verdict verdict-<%= answer.verdict %>">
                <%= verdicts[answer.verdict] %><% if (carName) { %><small>Your <%= carName %></small><% } %>
            </div>
        <% } %>

        <% answer.results.forEach(r => { %>
            <div class="code-card">
                <h3><%= r.code %> - <%= r.name %></h3>
                <%- include('../partials/severity', { level: r.severity }) %>
                <% if (r.problem) { %><p><strong>Problem:</strong> <%= r.problem %></p><% } %>
                <p><strong>What to do:</strong> <%= r.solution %></p>

                <% const h = r.history; %>
                <% if (h.times) { %>
                    <p class="history">
                        You logged this <%= h.times === 1 ? 'once' : `${h.times} times` %> on <%= carName ? `your ${carName}` : 'your cars' %><% if (h.lastFixed) { %>, last fixed <%= h.lastFixed.toLocaleDateString() %><% } %>.
                        <% if (h.times > 1 && h.lastFixed) { %><strong>It keeps coming back, the last repair may not have fixed the cause.</strong><% } %>
                    </p>
                <% } %>
                <% if (h.others) { %>
                    <p class="history"><%= h.others %> other <%= car ? `${car.make} owner` : 'driver' %><%= h.others === 1 ? '' : 's' %> logged this code.</p>
                <% } %>

                <% if (car) { %>
                    <% if (h.openOnCar) { %>
                        <a href="/garage/<%= car._id %>">Already open on your <%= carName %></a>
                    <% } else { %>
                        <form action="/garage/<%= car._id %>/logs" method="POST">
                            <input type="hidden" name="code" value="<%= r.code %>">
                            <button>Log on my <%= carName %></button>
                        </form>
                    <% } %>
                <% } %>
            </div>
        <% }) %>

        <% if (answer.analysis) { %>
            <section class="analysis">
                <h2>What I understood</h2>
                <div class="symptoms">
                    <% answer.analysis.symptoms.forEach(s => { %><span class="chip"><%= s.label %></span><% }) %>
                </div>
                <p class="analysis-lead">Most likely causes<%= carName ? ` on your ${carName}` : '' %>:</p>
                <% answer.analysis.suggestions.forEach(s => { %>
                    <div class="guess">
                        <div class="guess-head">
                            <strong><%= s.code %></strong>
                            <span class="guess-name"><%= s.name %></span>
                            <%- include('../partials/severity', { level: s.severity }) %>
                        </div>
                        <progress class="meter" value="<%= s.confidence %>" max="100" aria-label="<%= s.confidence %>% likely"></progress>
                        <p class="why">
                            <%= s.confidence %>% likely. Matches: <%= s.because.join(', ') %><% if (s.seen) { %>. Logged <%= s.seen %> time<%= s.seen === 1 ? '' : 's' %> by <%= car ? `${car.make} owners` : 'drivers' %><% } %><% if (s.hadBefore) { %>. <strong>Your car had this before</strong><% } %>.
                        </p>
                        <% if (s.solution) { %><p class="why"><strong>What to do:</strong> <%= s.solution %></p><% } %>
                        <% if (car) { %>
                            <form action="/garage/<%= car._id %>/logs" method="POST">
                                <input type="hidden" name="code" value="<%= s.code %>">
                                <input type="hidden" name="note" value="Suggested by the assistant: <%= answer.analysis.symptoms.map(x => x.label).join(', ') %>">
                                <button>Log on my <%= carName %></button>
                            </form>
                        <% } %>
                    </div>
                <% }) %>
                <p class="why">A scanner reading is the only way to be sure. Plug one in and ask me about the code it shows.</p>
            </section>
        <% } %>

        <% answer.knowledge.forEach(k => { %>
            <p><strong><%= k.topic %>:</strong> <%= k.content %></p>
        <% }) %>

        <% if (answer.openLogs.length) { %>
            <p>Open faults on <%= carName ? `your ${carName}` : 'your cars' %>:</p>
            <ul>
                <% answer.openLogs.forEach(log => { %>
                    <li>
                        <strong><%= log.code %></strong>
                        <% if (log.car) { %>on <a href="/garage/<%= log.car._id %>"><%= log.car.make %> <%= log.car.model %></a><% } %>
                        (<%= log.status %>)
                    </li>
                <% }) %>
            </ul>
        <% } %>

        <% if (!answer.said && !answer.results.length && !answer.analysis && !answer.knowledge.length && !answer.openLogs.length) { %>
            <p>I could not find an answer. Describe what the car is doing (shaking, overheating, hard to start...) or type the code, for example P0420.</p>
        <% } %>

        <% if (agent.instructions.length) { %>
            <ul>
                <% agent.instructions.forEach(i => { %><li><small><%= i %></small></li><% }) %>
            </ul>
        <% } %>

        <h3>Wrong answer?</h3>
        <form action="/agent/feedback" method="POST">
            <input type="hidden" name="question" value="<%= question %>">
            <input type="hidden" name="answer" value="<%= answer.summary %>">
            <input name="correction" maxlength="500" placeholder="What is the right answer?" required>
            <button>Send</button>
        </form>
    <% } %>
<% } %>
<%- include('../partials/foot') %>
