<%- include('../partials/head', { title: 'Agent Control' }) %>
<h1>Agent Control</h1>

<h2>Settings</h2>
<form action="/agent/admin?_method=PUT" method="POST">
    <label>Name <input name="name" value="<%= agent.name %>" required></label>
    <label>Status
        <select name="status">
            <% statuses.forEach(s => { %>
                <option value="<%= s %>" <%= agent.status === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
        </select>
    </label>
    <label>Instructions (one per line)
        <textarea name="instructions" rows="4"><%= agent.instructions.join('\n') %></textarea>
    </label>
    <button>Save</button>
</form>

<h2>User corrections (<%= agent.feedback.length %>)</h2>
<% if (!agent.feedback.length) { %><p>Nothing to review.</p><% } else { %>
<table>
    <thead><tr><th>Question</th><th>Agent answer</th><th>Correction</th><th></th></tr></thead>
    <tbody>
    <% agent.feedback.forEach(f => { %>
        <tr>
            <td><%= f.question %></td>
            <td><%= f.answer %></td>
            <td><%= f.correction %></td>
            <td>
                <form action="/agent/admin/feedback/<%= f._id %>?_method=PUT" method="POST"><button>Approve</button></form>
                <details class="danger-zone">
                    <summary>Reject</summary>
                    <form action="/agent/admin/feedback/<%= f._id %>?_method=DELETE" method="POST"><button class="danger">Yes, reject</button></form>
                </details>
            </td>
        </tr>
    <% }) %>
    </tbody>
</table>
<% } %>

<h2>Unknown codes (<%= unknownCodes.length %>)</h2>
<% if (!unknownCodes.length) { %><p>All logged codes are in the database.</p><% } %>
<% unknownCodes.forEach(u => { %>
    <form action="/agent/admin/codes" method="POST">
        <input type="hidden" name="code" value="<%= u.code %>">
        <p><strong><%= u.code %></strong> <small><%= u.text %></small></p>
        <input name="name" placeholder="Name" required>
        <input name="problem" placeholder="Problem">
        <input name="solution" placeholder="Solution">
        <select name="severity">
            <option value="drive">Keep driving</option>
            <option value="soon" selected>Visit a workshop soon</option>
            <option value="stop">Stop the car now</option>
        </select>
        <button>Add code</button>
    </form>
<% }) %>

<h2>Knowledge</h2>
<form action="/agent/admin/knowledge" method="POST">
    <input name="topic" placeholder="Topic (e.g. gas cap)" required>
    <input name="content" placeholder="What the agent should say" required>
    <button>Add</button>
</form>
<% if (agent.knowledge.length) { %>
<table>
    <thead><tr><th>Topic</th><th>Content</th><th></th></tr></thead>
    <tbody>
    <% agent.knowledge.forEach(k => { %>
        <tr>
            <td><%= k.topic %></td>
            <td><%= k.content %></td>
            <td>
                <details class="danger-zone">
                    <summary>Delete</summary>
                    <form action="/agent/admin/knowledge/<%= k._id %>?_method=DELETE" method="POST"><button class="danger">Yes, delete</button></form>
                </details>
            </td>
        </tr>
    <% }) %>
    </tbody>
</table>
<% } else { %>
<p class="muted">No knowledge added yet.</p>
<% } %>
<%- include('../partials/foot') %>
